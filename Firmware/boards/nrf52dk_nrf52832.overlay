/*
 * Smart Hydration Band - MAX30101 and BMI270 overlay.
 *
 * The PCB uses a BMD-350-A-R (nRF52832) module. The nRF52 DK board target is
 * used only as a convenient nRF52832 base; I2C0 already defaults to the PCB's
 * SDA P0.26 / SCL P0.27 pins.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/*
 * BMI270 CSB (P0.23) has no pull-up on the PCB and the chip uses it to choose
 * between I2C and SPI. Hold it high from before the application starts.
 */
&gpio0 {
	bmi270-csb-hog {
		gpio-hog;
		gpios = <23 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <100000>;

	/*
	 * src/max30101.c checks the mode, slots, rate, averaging and pulse width
	 * at build time because the heart-rate timing depends on them.
	 */
	max30101: max30101@57 {
		compatible = "maxim,max30101";
		reg = <0x57>;
		status = "okay";
		/* Slot 1 = red, slot 2 = IR, slot 3 = green. */
		acq-mode = "multi-led";
		led-slot = <1 2 3 0>;
		/*
		 * [red IR green], 0.2 mA/LSB: ~19 mA, ~38 mA, ~19 mA. IR carries the
		 * wrist pulse on this board, so it gets the extra light.
		 */
		led-pa = [60 C0 60];
		/* 100 Hz, no on-chip averaging. */
		smp-sr = <100>;
		smp-ave = <1>;
		/* 411 us pulse = 18-bit samples; the driver default is 69 us / 15-bit. */
		led-pw = <411>;
		/* 62.5 pA/LSB, so double the IR light stays in range. */
		adc-rge = <16384>;
	};

	/* SDO is tied to GND. INT1/INT2 (P0.30/P0.31) are not used: steps are polled. */
	bmi270: bmi270@68 {
		compatible = "bosch,bmi270";
		reg = <0x68>;
		status = "okay";
	};
};

/*
 * The DK board enables SPI1/SPI2 on pins the wristband uses for the BMI270
 * interrupt/CS lines, the haptic motor, and the WS2812 data line. Disable them
 * so those peripherals cannot claim the pins.
 */
&spi1 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};
