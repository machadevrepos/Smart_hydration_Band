/*
 * Smart Hydration Band - MAX30101 and BMI270 overlay.
 *
 * The PCB uses a BMD-350-A-R (nRF52832) module. The nRF52 DK board target is
 * used only as a convenient nRF52832 base; I2C0 already defaults to the PCB's
 * SDA P0.26 / SCL P0.27 pins.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/led/led.h>

/*
 * BMI270 CSB (P0.23) has no pull-up on the PCB and the chip uses it to choose
 * between I2C and SPI. Hold it high from before the application starts.
 */
&gpio0 {
	bmi270-csb-hog {
		gpio-hog;
		gpios = <23 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <100000>;

	/*
	 * src/max30101.c checks the mode, slots, rate, averaging and pulse width
	 * at build time because the heart-rate timing depends on them.
	 */
	max30101: max30101@57 {
		compatible = "maxim,max30101";
		reg = <0x57>;
		status = "okay";
		/*
		 * Slot 1 red, slot 2 IR. IR carries the wrist pulse and runs all the
		 * time; red is for SpO2 and starts off (current 0), lit only during a
		 * measurement. Green cannot work from the 3.3 V LED supply.
		 */
		acq-mode = "multi-led";
		led-slot = <1 2 0 0>;
		/* [red IR green], 0.2 mA/LSB: red off, IR ~38 mA. */
		led-pa = [00 C0 00];
		/* 100 Hz, no on-chip averaging. */
		smp-sr = <100>;
		smp-ave = <1>;
		/* 411 us pulse = 18-bit samples; the driver default is 69 us / 15-bit. */
		led-pw = <411>;
		/* 62.5 pA/LSB, so double the IR light stays in range. */
		adc-rge = <16384>;
	};

	/* SDO is tied to GND. INT1/INT2 (P0.30/P0.31) are not used: steps are polled. */
	bmi270: bmi270@68 {
		compatible = "bosch,bmi270";
		reg = <0x68>;
		status = "okay";
	};
};

/*
 * Haptic motor: P0.24 drives the gate of low-side switch Q1 through R12. R13
 * holds the gate low until the pin is configured. "gpio-leds" is only a plain
 * output description here; no LED driver is enabled.
 */
/ {
	haptic {
		compatible = "gpio-leds";

		haptic_motor: haptic_motor {
			gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
			label = "Haptic motor";
		};
	};
};

/*
 * Battery voltage: V_bat through R10 (800k) and R11 (2M) into P0.28 / AIN4. The
 * long acquisition time suits the divider's high impedance.
 */
/ {
	zephyr,user {
		io-channels = <&adc 0>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN4>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
	};
};

/* Push button SW2: P0.14 to GND, no pull-up on the PCB. */
&button1 {
	gpios = <&gpio0 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};

/*
 * WS2812 D4, data on P0.25. SPI is used only to shape the data pulses. The DK's
 * default pins would claim P0.23 (BMI270 CSB) and P0.24 (motor), so these are
 * set here. MOSI is the data line. SCK is on P0.22, unconnected on this PCB: the
 * SPIM stalls without a clock pin, so it needs one even though nothing uses it.
 */
&pinctrl {
	led_spi_default: led_spi_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 22)>,
				<NRF_PSEL(SPIM_MOSI, 0, 25)>;
		};
	};

	led_spi_sleep: led_spi_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 22)>,
				<NRF_PSEL(SPIM_MOSI, 0, 25)>;
			low-power-enable;
		};
	};
};

&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	/delete-property/ cs-gpios;
	pinctrl-0 = <&led_spi_default>;
	pinctrl-1 = <&led_spi_sleep>;
	pinctrl-names = "default", "sleep";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>; /* Ignored, but required by SPI bindings. */
		spi-max-frequency = <4000000>;

		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
		/* 250 ns per SPI bit; values from Zephyr's nRF52 led_strip sample. */
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		reset-delay = <300>;
	};
};

/*
 * The DK board enables SPI1 on pins the wristband uses for other signals.
 * Disable it so it cannot claim them.
 */
&spi1 {
	status = "disabled";
};

/* Hardware watchdog, used by src/watchdog.c. */
&wdt0 {
	status = "okay";
};

/* Not wired up on this PCB, and output goes over RTT. */
&uart0 {
	status = "disabled";
};
